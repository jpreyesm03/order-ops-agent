# Copy to .env (never committed).

# Postgres: local (scripts/dev_db.sh up) or Neon in production. The database must be named orderops_p5.
DATABASE_URL=postgresql://orderops:orderops@127.0.0.1:55433/orderops_p5

# Claude API key (create it in the Anthropic console and set a spend cap)
ANTHROPIC_API_KEY=

# models
AGENT_MODEL=claude-haiku-5-5
SIM_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5

# refunds / money movements above this amount (USD) wait for a human in the live app
APPROVAL_THRESHOLD_USD=250

# τ²-bench harness (evals/TAU2.md): the simulated customer's model
TAU2_USER_MODEL=claude-haiku-5-5

# tracing (off unless one exporter is set; see src/order_ops/tracing.py)
# ORDER_OPS_TRACE_ENDPOINT=http://localhost:6006/v1/traces     # Phoenix: uvx --from arize-phoenix phoenix serve
# ORDER_OPS_TRACE_URL=http://localhost:6006/projects/UHJvamVjdDox/traces/{trace_id}
# ORDER_OPS_TRACE_CONTENT=1                                     # local debugging only: adds message text to spans

# Voice channel (D26, evals/VOICE.md). Off unless all three are set.
# TWILIO_AUTH_TOKEN=
# VOICE_RELAY_SECRET=
# VOICE_WS_URL=wss://<tunnel>/voice/ws
# VOICE_PUBLIC_URL=https://<tunnel>
